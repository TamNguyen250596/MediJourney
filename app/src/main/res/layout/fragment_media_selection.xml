<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="2"
    tools:context=".common.ui_components.fragments.media_selection.MediaSelectionFragment">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cameraButton"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:backgroundTint="@color/light_blue_color"
        android:text="@string/camera"
        android:textAlignment="viewStart"
        android:textColor="@color/deep_turquoise_blue_color"
        android:textSize="20sp"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_camera"
        app:iconSize="40dp"
        app:iconTint="@color/deep_turquoise_blue_color"
        app:strokeColor="@color/deep_turquoise_blue_color"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/galleryButton"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:backgroundTint="@color/deep_turquoise_blue_color"
        android:text="@string/gallery"
        android:textAlignment="viewStart"
        android:textColor="@color/light_blue_color"
        android:textSize="20sp"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_gallery"
        app:iconSize="40dp"
        app:iconTint="@color/light_blue_color" />
</LinearLayout>
