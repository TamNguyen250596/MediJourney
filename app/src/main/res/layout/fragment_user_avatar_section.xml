<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".common.ui_components.fragments.user_avatar_section.UserAvatarSectionFragment">

    <ImageView
        android:id="@+id/profileBGImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/corn_flower_blue_color"
        android:contentDescription="Profile background image"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <ImageButton
        android:id="@+id/editProfileBGButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/ic_edit_pen"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/profileBGImageView"
        app:layout_constraintEnd_toEndOf="@id/profileBGImageView" />

    <androidx.cardview.widget.CardView
        android:id="@+id/avatarCardView"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.90999997">

        <ImageView
            android:id="@+id/avatarImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_profile"
            tools:ignore="ContentDescription" />

    </androidx.cardview.widget.CardView>

    <ImageButton
        android:id="@+id/editAvatarButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:elevation="8dp"
        android:background="@drawable/ic_edit_pen"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avatarCardView"
        app:layout_constraintEnd_toEndOf="@id/avatarCardView" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatarCardView"
        app:layout_constraintTop_toBottomOf="@+id/profileBGImageView">

        <TextView
            android:id="@+id/userNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/proximanova_bold"
            android:text="@string/user_name"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/membershipLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/membershipImageView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/membershipTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/proximanova_regular"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>