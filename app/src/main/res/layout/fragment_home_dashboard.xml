<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".modules.dashboard.home.HomeDashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/advertisementComposeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/topDashboardMenusComposeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/homeDoctorAppointmentComposeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/medicalPurchaseProgressComposeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/homeOnboardingComposeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>


</ScrollView>