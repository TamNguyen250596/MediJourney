<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediJourney" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">@font/proximanova_font_family</item>
        <item name="fontFamily">@font/proximanova_font_family</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="custom_tool_bar_appearance" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">@font/proximanova_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/disable_grey_color</item>
    </style>

    <style name="ThemeOverlay.AppTheme.TextInputEditText.Outlined" parent="">
        <item name="colorPrimary">@color/black</item>
    </style>

    <style name="default_tab_bar_text_style" parent="@android:style/TextAppearance.Widget.TabWidget">
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">@color/tab_bar_tint_color</item>
        <item name="android:fontFamily">@font/proximanova_bold</item>
    </style>

    <style name="check_box_style" parent="Base.Theme.AppCompat">
        <item name="colorAccent">@color/deep_turquoise_blue_color</item>
        <item name="android:textColorSecondary">@color/disable_grey_color</item>
    </style>
</resources>